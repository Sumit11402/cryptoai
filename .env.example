# ====================================================================
# CRYPTØ AI TERMINAL — Environment Configuration Template
# ====================================================================
# The terminal is designed for a ₹0 Mandatory API Budget.
# Neither Groq nor OpenAI nor Binance keys are required to use
# the terminal; it works out-of-the-box with local Ollama, 
# public market data, and offline analytical synthesis.

# 1. Cloud AI Provider — Groq (100% Free Forever Tier)
# Get your free key at: https://console.groq.com/keys (No credit card required)
GROQ_API_KEY=

# 2. Local AI Provider — Ollama (100% Free & Offline On-Device AI)
# Download Ollama at: https://ollama.com
# Example models: 'ollama run llama3.2' or 'ollama run deepseek-r1'
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 3. Twilio Mobile SMS / WhatsApp Alert Dispatcher (100% Free Trial Tier)
# Get free trial credentials at: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# 4. Optional Future Credentials (NOT required for public market data)
BINANCE_API_KEY=
BINANCE_API_SECRET=

